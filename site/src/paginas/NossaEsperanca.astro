---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { L, UI, WHATSAPP, route, type Lang } from "../lib/i18n";
import { comDominio, seo } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const path = route("esperanca", lang);
const meta = seo("/nossa-esperanca", lang);
const site = Astro.site!.href.replace(/\/+$/, "");

// Mesma pendência da página Sobre: a foto apontava para /assets/equipe/stefan.jpg,
// que não existe. Preencher quando o arquivo for publicado em uploads/equipe/.
const FOTO_LIDERANCA: string | null = null;

const kicker =
  "font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:#13BE9F";
const h2 = "margin:0;font-size:clamp(30px,3.4vw,44px);line-height:1.1;letter-spacing:-.03em;font-weight:600";
const corpo = "margin:0;font-size:16.5px;line-height:1.75;color:rgba(244,243,240,.68)";
const citacao = "margin:0 0 10px;font-size:clamp(20px,2.4vw,28px);line-height:1.5";
const fonte =
  "font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.5)";
const bloco = "max-width:820px;margin:0 auto;padding:110px 32px 0;display:flex;flex-direction:column;gap:18px";
const ruido =
  "url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22 opacity=%220.05%22/></svg>')";

const breadcrumb = [
  { name: L(lang, "Início", "Home"), url: route("home", lang) },
  { name: UI.nav.esperanca[lang], url: path },
];
---

<Base
  lang={lang}
  title={meta.title}
  description={meta.description}
  path={path}
  ogImage={meta.og}
  jsonLd={comDominio(meta.jsonLd, site)}
  breadcrumb={breadcrumb}
>
  <div style="font-family:Sora,'Helvetica Neue',sans-serif;background:#0D0D0D;color:#F4F3F0;min-height:100vh">
    <SiteNav lang={lang} path={path} dark />

    <header style="position:relative;overflow:hidden;border-bottom:1px solid rgba(244,243,240,.08)">
      <div style={`position:absolute;inset:0;background-image:${ruido};pointer-events:none`}></div>
      <div
        data-r="p1 g1"
        style="position:relative;max-width:1240px;margin:0 auto;padding:170px 32px 100px;display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center"
      >
        <div style="display:flex;flex-direction:column;gap:26px">
          <div data-reveal style="display:flex;align-items:center;gap:14px">
            <span style="width:34px;height:1px;background:#13BE9F"></span>
            <span
              style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.6)"
              >{UI.nav.esperanca[lang]}</span
            >
          </div>
          <h1
            data-reveal
            style="margin:0;font-size:clamp(40px,5vw,68px);line-height:1.05;letter-spacing:-.03em;font-weight:600;text-wrap:balance"
          >
            {L(lang, "Do alívio da dor à cura completa.", "From pain relief to complete healing.")}
          </h1>
          <p data-reveal style="margin:0;max-width:560px;font-size:17px;line-height:1.7;color:rgba(244,243,240,.68)">
            {
              L(
                lang,
                "O nome Setfree carrega um duplo sentido: libertar o paciente da dor — e uma liberdade ainda maior. Esta página é sobre essa liberdade maior.",
                "The name Setfree carries a double meaning: to free the patient from pain — and a greater freedom still. This page is about that greater freedom.",
              )
            }
          </p>
          <span data-reveal style="font-size:15.5px;color:rgba(244,243,240,.55)">
            {L(lang, "“Deus em primeiro lugar” · nosso primeiro valor", "“God first” · our first value")}
          </span>
        </div>
        <div data-reveal style="position:relative;display:flex;justify-content:center;align-items:center">
          <img
            src="/uploads/pena-casa-verde.jpg"
            alt={L(lang, "Pena Setfree", "Setfree feather")}
            width="320"
            height="420"
            style="width:min(320px,28vw);height:auto;display:block;-webkit-mask-image:radial-gradient(72% 72% at 50% 48%,#000 50%,transparent 97%);mask-image:radial-gradient(72% 72% at 50% 48%,#000 50%,transparent 97%);animation:sfFloat 9s ease-in-out infinite"
          />
        </div>
      </div>
      <div
        data-sf-neon="1"
        style="position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,rgba(19,190,159,0),#13BE9F 15%,#13BE9F 85%,rgba(19,190,159,0));animation:sfNeon 4.5s ease-in-out infinite"
      >
      </div>
    </header>

    <section>
      <div data-r="p2" style={bloco}>
        <span data-reveal style={kicker}>{L(lang, "POR QUE ESTA PÁGINA EXISTE", "WHY THIS PAGE EXISTS")}</span>
        <h2 data-reveal style={h2}>{L(lang, "Somos uma empresa de fé.", "We are a company of faith.")}</h2>
        <p data-reveal style={corpo}>
          {
            L(
              lang,
              "“Deus em primeiro lugar” é o primeiro dos nossos valores — vem antes de qualquer produto ou meta. Não escrevemos isto para te convencer de nada. Escrevemos porque seria desonesto esconder o que nos move.",
              "“God first” is the first of our values — it comes before any product or goal. We don't write this to convince you of anything. We write it because it would be dishonest to hide what moves us.",
            )
          }
        </p>
        <div data-reveal style="margin-top:26px;border-left:2px solid #13BE9F;padding:6px 0 6px 28px">
          <p style={citacao}>
            {
              L(
                lang,
                "“…e conhecereis a verdade, e a verdade vos libertará.”",
                "“…and you will know the truth, and the truth will set you free.”",
              )
            }
          </p>
          <span style={fonte}>{L(lang, "JOÃO 8:32", "JOHN 8:32")}</span>
        </div>
      </div>
    </section>

    <section>
      <div data-r="p2" style={bloco}>
        <span data-reveal style={kicker}>{L(lang, "UMA PERGUNTA HONESTA", "AN HONEST QUESTION")}</span>
        <h2 data-reveal style={`${h2};text-wrap:balance`}>
          {L(lang, "Você já sentiu que falta algo?", "Have you ever felt something is missing?")}
        </h2>
        <p data-reveal style={corpo}>
          {
            L(
              lang,
              "Trabalhamos todos os dias para aliviar a dor do corpo. Mas existe uma inquietação que nenhum instrumento alcança — a sensação de que fomos feitos para algo maior do que nós mesmos.",
              "We work every day to relieve the body's pain. But there is a restlessness no instrument can reach — the sense that we were made for something greater than ourselves.",
            )
          }
        </p>
      </div>
    </section>

    <section>
      <div data-r="p2" style={bloco}>
        <span data-reveal style={kicker}>{L(lang, "A ESPERANÇA", "THE HOPE")}</span>
        <h2 data-reveal style={`${h2};text-wrap:balance`}>
          {L(lang, "Há uma só esperança — e ela tem um nome.", "There is one hope — and it has a name.")}
        </h2>
        <div data-reveal style="margin-top:8px;border-left:2px solid #13BE9F;padding:6px 0 6px 28px">
          <p style={citacao}>
            {
              L(
                lang,
                "“Porque Deus amou o mundo de tal maneira que deu o seu Filho unigênito, para que todo aquele que nele crê não pereça, mas tenha a vida eterna.”",
                "“For God so loved the world that he gave his one and only Son, that whoever believes in him shall not perish but have eternal life.”",
              )
            }
          </p>
          <span style={fonte}>{L(lang, "JOÃO 3:16", "JOHN 3:16")}</span>
        </div>
        <p data-reveal style={corpo}>
          {
            L(
              lang,
              "A cura completa não é um produto que distribuímos. É uma pessoa: Jesus. Ele veio para nos reconciliar com Deus e nos tornar livres de verdade.",
              "Complete healing is not a product we distribute. It is a person: Jesus. He came to reconcile us with God and make us truly free.",
            )
          }
        </p>
      </div>
    </section>

    <section>
      <div data-r="p2" style={bloco}>
        <span data-reveal style={kicker}>{L(lang, "O CONVITE", "THE INVITATION")}</span>
        <h2 data-reveal style={`${h2};text-wrap:balance`}>
          {L(lang, "Ele convida — e respeita a sua resposta.", "He invites — and respects your answer.")}
        </h2>
        <p data-reveal style={corpo}>
          {
            L(
              lang,
              "Deus jamais força ninguém. Ele bate à porta e espera. Se algo aqui tocou você, pode conversar com Ele agora, com as suas próprias palavras — ou usar esta oração.",
              "God never forces anyone. He knocks at the door and waits. If something here touched you, you can talk to Him now, in your own words — or use this prayer.",
            )
          }
        </p>
        <div data-reveal style="margin-top:8px;border-left:2px solid #13BE9F;padding:6px 0 6px 28px">
          <p style={citacao}>
            {
              L(
                lang,
                "“Eis que estou à porta e bato; se alguém ouve a minha voz e abre a porta, entrarei.”",
                "“Here I am! I stand at the door and knock. If anyone hears my voice and opens the door, I will come in.”",
              )
            }
          </p>
          <span style={fonte}>{L(lang, "APOCALIPSE 3:20", "REVELATION 3:20")}</span>
        </div>
        <div data-reveal>
          <button
            id="sf-oracao-btn"
            type="button"
            aria-expanded="false"
            aria-controls="sf-oracao"
            data-abrir={L(lang, "Ler a oração ↓", "Read the prayer ↓")}
            data-fechar={L(lang, "Fechar ↑", "Close ↑")}
            data-h="borda"
            style="background:transparent;border:1px solid rgba(244,243,240,.25);color:#F4F3F0;border-radius:999px;padding:12px 26px;font-family:inherit;font-size:14.5px;font-weight:500;cursor:pointer"
            >{L(lang, "Ler a oração ↓", "Read the prayer ↓")}</button
          >
        </div>
        <div
          id="sf-oracao"
          hidden
          style="background:rgba(244,243,240,.04);border:1px solid rgba(244,243,240,.12);border-radius:4px;padding:34px 36px;margin-top:6px"
        >
          <p style="margin:0;font-size:19px;line-height:1.8;color:#F4F3F0">
            {
              L(
                lang,
                "Senhor Jesus, eu reconheço que preciso de Ti. Obrigado por dares a Tua vida por mim. Entra no meu coração, perdoa-me e conduz a minha vida. Hoje, coloco a minha esperança em Ti. Amém.",
                "Lord Jesus, I acknowledge that I need You. Thank You for giving Your life for me. Come into my heart, forgive me and lead my life. Today, I place my hope in You. Amen.",
              )
            }
          </p>
        </div>
        <a data-reveal href={WHATSAPP} data-h="verde-claro" style="color:#13BE9F;font-size:15px;font-weight:600;margin-top:6px">
          {L(lang, "Quer conversar com alguém? Fale com a gente ›", "Want to talk to someone? Reach out to us ›")}
        </a>
      </div>
    </section>

    <section style="position:relative;overflow:hidden;margin-top:110px">
      <img
        src="/uploads/asa-linha-azul.jpg"
        alt={L(lang, "Asa — penas escuras com pena azul", "Wing — dark feathers with a blue feather")}
        loading="lazy"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.5"
      />
      <div style="position:absolute;inset:0;background:linear-gradient(180deg,#0D0D0D 0%,rgba(13,13,13,.55) 50%,#0D0D0D 100%)">
      </div>
      <div data-r="p3" style="position:relative;max-width:900px;margin:0 auto;padding:140px 32px;text-align:center">
        <p data-reveal style="margin:0 0 14px;font-size:clamp(24px,3vw,36px);line-height:1.45;text-wrap:balance">
          {
            L(
              lang,
              "“…mas os que esperam no Senhor renovarão as suas forças; subirão com asas como águias.”",
              "“…but those who hope in the Lord will renew their strength. They will soar on wings like eagles.”",
            )
          }
        </p>
        <span
          data-reveal
          style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.65)"
          >{L(lang, "ISAÍAS 40:31", "ISAIAH 40:31")}</span
        >
      </div>
    </section>

    <section>
      <div
        data-r="p4"
        style="max-width:820px;margin:0 auto;padding:110px 32px 120px;display:flex;flex-direction:column;align-items:center;gap:34px;text-align:center"
      >
        <h2
          data-reveal
          style="margin:0;font-size:clamp(28px,3.2vw,42px);line-height:1.1;letter-spacing:-.03em;font-weight:600"
        >
          {L(lang, "A Deus, toda honra e glória.", "To God, all honor and glory.")}
        </h2>
        <div data-reveal style="display:flex;flex-direction:column;align-items:center;gap:14px">
          {
            FOTO_LIDERANCA && (
              <span style="width:74px;height:88px;border-radius:4px;overflow:hidden;display:block">
                <img
                  src={FOTO_LIDERANCA}
                  alt="Stefan Cabral"
                  loading="lazy"
                  width="74"
                  height="88"
                  style="width:100%;height:100%;object-fit:cover;display:block"
                />
              </span>
            )
          }
          <div style="display:flex;flex-direction:column;gap:3px">
            <strong style="font-size:15.5px;font-weight:600">Stefan Cabral</strong>
            <span
              style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.5)"
              >{L(lang, "FUNDADOR & CEO, SETFREE", "FOUNDER & CEO, SETFREE")}</span
            >
          </div>
        </div>
      </div>
    </section>

    <SiteFooter lang={lang} />
  </div>
</Base>

<style is:global>
  @media (max-width: 980px) {
    [data-r~="p1"] {
      padding: 128px 22px 70px !important;
    }
    [data-r~="p2"] {
      padding: 72px 22px 0 !important;
    }
    [data-r~="p3"] {
      padding: 96px 22px !important;
    }
    [data-r~="p4"] {
      padding: 72px 22px 80px !important;
    }
    [data-r~="g1"] {
      grid-template-columns: 1fr !important;
      gap: 34px !important;
    }
  }
</style>

<script>
  const btn = document.getElementById("sf-oracao-btn");
  const caixa = document.getElementById("sf-oracao");
  if (btn && caixa) {
    btn.addEventListener("click", () => {
      const abrindo = caixa.hasAttribute("hidden");
      caixa.toggleAttribute("hidden", !abrindo);
      btn.setAttribute("aria-expanded", String(abrindo));
      btn.textContent = abrindo ? btn.dataset.fechar! : btn.dataset.abrir!;
    });
  }
</script>
