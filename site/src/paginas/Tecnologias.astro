---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { L, UI, WHATSAPP, linhaUrl, route, type Lang } from "../lib/i18n";
import { linhas } from "../data";
import { comDominio, seo } from "../lib/seo";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const path = route("tecnologias", lang);
const meta = seo("/tecnologias", lang);
const site = Astro.site!.href.replace(/\/+$/, "");

// Grupos do filtro. A chave é estável; o rótulo é traduzido.
const GRUPOS = [
  { key: "todos", label: L(lang, "TODOS", "ALL") },
  { key: "regeneracao", label: L(lang, "REGENERAÇÃO", "REGENERATION") },
  { key: "microcirurgia", label: L(lang, "MICROCIRURGIA", "MICROSURGERY") },
  { key: "dor", label: L(lang, "DOR", "PAIN") },
  { key: "cuidado", label: L(lang, "CUIDADO", "CARE") },
  { key: "odontologia", label: L(lang, "ODONTOLOGIA", "DENTISTRY") },
  { key: "hospitalar", label: L(lang, "HOSPITALAR", "HOSPITAL") },
];

const GRUPO_DE: Record<string, string> = {
  corebone: "regeneracao",
  geister: "microcirurgia",
  radimed: "dor",
  "marrow-cellution": "regeneracao",
  lipsus: "cuidado",
  dentsply: "odontologia",
  "parceiros-estrategicos": "hospitalar",
};

// Ordem e descrições próprias desta página (mais longas que as da home).
const ORDEM = ["corebone", "geister", "radimed", "marrow-cellution", "lipsus", "dentsply", "parceiros-estrategicos"];
const DESC: Record<string, { pt: string; en: string }> = {
  corebone: {
    pt: "Enxerto ósseo bioativo de origem coral. A CNN Business mostrou sua fabricação, aplicabilidade e benefícios.",
    en: "Coral-derived bioactive bone graft. CNN Business covered its manufacturing, applicability and benefits.",
  },
  geister: {
    pt: "Micro lâminas de precisão — “The better way to operate”. Configurações angulada, meia-lua e cabo para procedimentos delicados.",
    en: "Precision micro blades — “The better way to operate”. Angled, crescent and handle configurations for delicate procedures.",
  },
  radimed: {
    pt: "Cânulas e agulhas para radiofrequência — técnica minimamente invasiva e alvo-seletiva no tratamento da dor crônica.",
    en: "Cannulas and needles for radiofrequency — a minimally invasive, target-selective technique in the treatment of chronic pain.",
  },
  "marrow-cellution": {
    pt: "Sistema de aspiração de medula óssea para coleta avançada de células-tronco — tratamentos regenerativos e minimamente invasivos.",
    en: "Bone marrow aspiration system for advanced stem cell harvesting — regenerative, minimally invasive treatments.",
  },
  lipsus: {
    pt: "Bolsa de água para umedecimento contínuo dos lábios — conforto na recuperação pós-cirúrgica.",
    en: "Water pouch for continuous lip moistening — comfort during post-surgical recovery.",
  },
  dentsply: {
    pt: "Linha OSSIX de regeneração óssea e tecidual guiada — tecnologia GLYMATRIX, da divisão Regenerative Solutions.",
    en: "The OSSIX line of guided bone and tissue regeneration — GLYMATRIX technology, from the Regenerative Solutions division.",
  },
  "parceiros-estrategicos": {
    pt: "Produtos hospitalares para o dia a dia das instituições de saúde — fornecimento por venda direta e licitações.",
    en: "Hospital products for the daily routine of healthcare institutions — supplied through direct sale and public tenders.",
  },
};
const PROD: Record<string, string | undefined> = {
  corebone: "/uploads/produtos/corebone.png",
  geister: "/uploads/produtos/mk-angulada.png",
  radimed: "/uploads/produtos/radimed.png",
  "marrow-cellution": "/uploads/produtos/marrow.png",
  lipsus: "/uploads/produtos/lipsus.png",
  dentsply: "/uploads/produtos/ossix.png",
};

const lista = ORDEM.map((slug) => {
  const l = linhas(lang).find((x) => x.slug === slug)!;
  return {
    slug,
    grupo: GRUPO_DE[slug],
    nome: l.nome,
    cat: l.cat.split(" · ")[0],
    corClara: l.corClara,
    pena: l.pena,
    prod: PROD[slug],
    desc: DESC[slug][lang],
    href: linhaUrl(slug, lang),
    // o export apontava para /assets/catalogos/*, que não existe no servidor;
    // os PDFs reais estão em /uploads/catalogos/
    catalogo: l.catalogo,
    catLabel: l.catalogoLabel,
  };
});

const chipOn =
  "padding:9px 18px;border-radius:999px;cursor:pointer;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;transition:all .2s;background:#0D0D0D;color:#F4F3F0;border:1px solid #0D0D0D";
const chipOff =
  "padding:9px 18px;border-radius:999px;cursor:pointer;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;transition:all .2s;background:rgba(255,255,255,.5);backdrop-filter:blur(16px) saturate(150%);-webkit-backdrop-filter:blur(16px) saturate(150%);box-shadow:inset 0 1px 0 rgba(255,255,255,.9);color:#474E58;border:1px solid rgba(255,255,255,.7)";

const breadcrumb = [
  { name: L(lang, "Início", "Home"), url: route("home", lang) },
  { name: UI.nav.tecnologias[lang], url: path },
];
---

<Base
  lang={lang}
  title={meta.title}
  description={meta.description}
  path={path}
  ogImage={meta.og}
  jsonLd={comDominio(meta.jsonLd, site)}
  breadcrumb={breadcrumb}
>
  <div style="font-family:Sora,'Helvetica Neue',sans-serif;background:#F4F3F0;min-height:100vh">
    <SiteNav lang={lang} path={path} />

    <header style="background:#F4F3F0;border-bottom:1px solid rgba(13,13,13,.08)">
      <div data-r="p1" style="max-width:1240px;margin:0 auto;padding:150px 32px 56px">
        <div data-reveal style="display:flex;align-items:center;gap:14px;margin-bottom:24px">
          <span style="width:34px;height:1px;background:#13BE9F"></span>
          <span
            style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:#474E58"
            >{L(lang, "TECNOLOGIAS", "TECHNOLOGIES")}</span
          >
        </div>
        <h1
          data-reveal
          style="margin:0 0 22px;font-size:clamp(38px,4.6vw,62px);line-height:1.06;letter-spacing:-.03em;font-weight:600;max-width:820px;text-wrap:balance"
        >
          {L(lang, "Tecnologias que regeneram, aliviam e cuidam", "Technologies that regenerate, relieve and care")}
        </h1>
        <p data-reveal style="margin:0 0 40px;max-width:640px;font-size:16.5px;line-height:1.65;color:#474E58">
          {
            L(
              lang,
              "Sete linhas: seis de fabricantes de classe mundial e a nossa linha de parceiros estratégicos — importação e distribuição regularizadas junto à ANVISA, treinamento e suporte técnico no Brasil.",
              "Seven lines: six from world-class manufacturers and our strategic-partners line — import and distribution regularized with ANVISA, training and technical support in Brazil.",
            )
          }
        </p>
        <div id="sf-filtros" data-reveal style="display:flex;gap:10px;flex-wrap:wrap">
          {
            GRUPOS.map((g, i) => (
              <button type="button" data-grupo={g.key} aria-pressed={i === 0 ? "true" : "false"} style={i === 0 ? chipOn : chipOff}>
                {g.label}
              </button>
            ))
          }
        </div>
      </div>
    </header>

    <section style="background:#F4F3F0">
      <div
        id="sf-linhas"
        data-r="p2"
        style="max-width:1240px;margin:0 auto;padding:56px 32px 96px;display:flex;flex-direction:column;gap:20px"
      >
        {
          lista.map((l) => (
            <div
              data-reveal
              data-r="g1"
              data-grupo={l.grupo}
              style="display:grid;grid-template-columns:110px 230px 1fr;background:#0D0D0D;border-radius:4px;overflow:hidden;color:#F4F3F0"
            >
              <span style="display:block;overflow:hidden">
                <img
                  src={l.pena}
                  alt=""
                  loading="lazy"
                  style="width:100%;height:100%;object-fit:cover;object-position:50% 35%;display:block"
                />
              </span>
              <span style="display:flex;align-items:center;justify-content:center;background:#E7E6E2;padding:20px;position:relative;min-height:190px">
                {l.prod ? (
                  <img
                    src={l.prod}
                    alt={l.nome}
                    loading="lazy"
                    style="max-width:100%;max-height:150px;object-fit:contain;mix-blend-mode:multiply"
                  />
                ) : (
                  <span
                    style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.16em;line-height:1.7;text-align:center;color:#474E58"
                    set:html={L(lang, "PARCEIROS<br>ESTRATÉGICOS", "STRATEGIC<br>PARTNERS")}
                  />
                )}
              </span>
              <span style="display:flex;flex-direction:column;gap:10px;padding:26px 30px;justify-content:center">
                <span
                  style={`font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:${l.corClara}`}
                >
                  {l.cat}
                </span>
                <span style="font-size:24px;font-weight:600;letter-spacing:-.01em">{l.nome}</span>
                <span style="font-size:14.5px;color:rgba(244,243,240,.6);line-height:1.6;max-width:560px">{l.desc}</span>
                <span style="display:flex;gap:22px;flex-wrap:wrap;margin-top:6px;font-size:14px;font-weight:600">
                  <a href={l.href} data-h="verde-claro" style="color:#13BE9F">
                    {L(lang, "Saiba mais →", "Learn more →")}
                  </a>
                  {l.catalogo && (
                    <a href={l.catalogo} data-h="verde" style="color:rgba(244,243,240,.7)">
                      {l.catLabel}
                    </a>
                  )}
                  <a href={WHATSAPP} data-h="verde" style="color:rgba(244,243,240,.7)">
                    {UI.linha.falarEspecialista[lang]}
                  </a>
                </span>
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section style="background:#0D0D0D;color:#F4F3F0;position:relative;overflow:hidden">
      <div
        style="position:absolute;inset:0;background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22 opacity=%220.05%22/></svg>')"
      >
      </div>
      <div
        data-r="p3"
        style="position:relative;max-width:1240px;margin:0 auto;padding:88px 32px;display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap"
      >
        <div style="max-width:560px">
          <span
            data-reveal
            style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:#13BE9F"
            >{L(lang, "LICITAÇÕES", "TENDERS")}</span
          >
          <h2
            data-reveal
            style="margin:16px 0 12px;font-size:clamp(26px,3vw,38px);line-height:1.1;letter-spacing:-.03em;font-weight:600"
          >
            {L(lang, "Precisa de cotação para uma licitação?", "Need a quote for a tender?")}
          </h2>
          <p data-reveal style="margin:0;font-size:15.5px;line-height:1.65;color:rgba(244,243,240,.65)">
            {
              L(
                lang,
                "Nossa mesa de licitações orientada por dados responde com especificações verificadas e preços auditáveis.",
                "Our data-driven tender desk responds with verified specifications and auditable prices.",
              )
            }
          </p>
        </div>
        <a
          data-reveal
          data-mag="1"
          data-h="btn"
          href={WHATSAPP}
          style="background:#13BE9F;color:#0D0D0D;border-radius:999px;padding:15px 30px;font-size:15px;font-weight:600;white-space:nowrap"
          >{UI.nav.falarWhats[lang]}</a
        >
      </div>
      <div
        data-sf-neon="1"
        style="position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,rgba(19,190,159,0),#13BE9F 15%,#13BE9F 85%,rgba(19,190,159,0));animation:sfNeon 4.5s ease-in-out infinite"
      >
      </div>
    </section>

    <SiteFooter lang={lang} />
  </div>
</Base>

<style is:global>
  @media (max-width: 980px) {
    [data-r~="p1"] {
      padding: 116px 22px 44px !important;
    }
    [data-r~="p2"] {
      padding: 44px 22px 65px !important;
    }
    [data-r~="p3"] {
      padding: 65px 22px !important;
    }
    [data-r~="g1"] {
      grid-template-columns: 90px 1fr !important;
    }
    [data-r~="g1"] > span:nth-child(2) {
      display: none !important;
    }
  }
  @media (max-width: 620px) {
    [data-r~="g1"] {
      grid-template-columns: 1fr !important;
    }
    [data-r~="g1"] > span:first-child {
      height: 120px !important;
    }
  }
</style>

<script>
  // Filtro por grupo. No original era estado React; aqui é só mostrar/esconder.
  const filtros = document.getElementById("sf-filtros");
  const lista = document.getElementById("sf-linhas");
  if (filtros && lista) {
    const botoes = [...filtros.querySelectorAll<HTMLButtonElement>("button[data-grupo]")];
    const cartoes = [...lista.querySelectorAll<HTMLElement>("[data-grupo]")];
    const ligado = botoes[0].getAttribute("style")!;
    const desligado = botoes[1].getAttribute("style")!;

    filtros.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>("button[data-grupo]");
      if (!btn) return;
      const grupo = btn.dataset.grupo!;
      for (const b of botoes) {
        const ativo = b === btn;
        b.setAttribute("style", ativo ? ligado : desligado);
        b.setAttribute("aria-pressed", String(ativo));
      }
      for (const c of cartoes) {
        c.style.display = grupo === "todos" || c.dataset.grupo === grupo ? "" : "none";
      }
    });
  }
</script>
