    <section style="background:#F4F3F0;border-top:1px solid rgba(13,13,13,.08)">
      <div data-r="p5" style="max-width:1240px;margin:0 auto;padding:96px 32px 110px;text-align:center">
        <span data-reveal style={kickerVerde}>{L(lang, "NOSSA PROMESSA", "OUR PROMISE")}</span>
