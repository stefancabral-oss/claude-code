</style>

<script>
  // O vídeo do hero entra por cima do poster assim que puder tocar.
  const v = document.getElementById("sf-pena-hero") as HTMLVideoElement | null;
  if (v && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const mostra = () => {
      v.style.opacity = ".85";
      v.play().catch(() => {});
    };
    if (v.readyState >= 3) mostra();
    else v.addEventListener("canplay", mostra, { once: true });
  }
</script>
