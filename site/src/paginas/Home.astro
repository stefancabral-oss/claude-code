          <span style={kickerVerde}>{L(lang, "COMPLIANCE E REGULATÓRIO", "COMPLIANCE AND REGULATORY")}</span>
          <h2 style="margin:18px 0 0;font-size:clamp(28px,3vw,40px);line-height:1.12;letter-spacing:-.03em;font-weight:600">
