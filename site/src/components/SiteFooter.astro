---
import { EMAIL, TELEFONE, TELEFONE_HREF, UI, WHATSAPP, route, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const txt = {
  sobre: {
    pt: "Importadora e distribuidora de tecnologia médica. Tecnologias regenerativas e minimamente invasivas para a saúde brasileira.",
    en: "Importer and distributor of medical technology. Regenerative and minimally invasive technologies for Brazilian healthcare.",
  },
  contato: { pt: "CONTATO", en: "CONTACT" },
  navegacao: { pt: "NAVEGAÇÃO", en: "NAVIGATION" },
  anvisa: {
    pt: "IMPORTAÇÃO REGULARIZADA JUNTO À ANVISA",
    en: "IMPORT REGULARIZED WITH ANVISA",
  },
  intranet: { pt: "Acesso do time ↗", en: "Team access ↗" },
} as const;

const nav = [
  { key: "solucoes", pt: "Soluções", en: "Solutions" },
  { key: "tecnologias", pt: "Tecnologias", en: "Technologies" },
  { key: "sobre", pt: "Sobre", en: "About" },
  { key: "esperanca", pt: "Nossa Esperança", en: "Our Hope" },
  { key: "contato", pt: "Contato", en: "Contact" },
] as const;

const linkEstilo = "color:rgba(244,243,240,.78);font-size:14px";
const tituloEstilo =
  "font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45);margin-bottom:6px";
const ruido =
  "url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22 opacity=%220.04%22/></svg>')";
---

<footer
  style="background:#0D0D0D;color:#F4F3F0;position:relative;overflow:hidden;font-family:Sora,'Helvetica Neue',sans-serif"
>
  <div
    data-sf-neon="1"
    style="height:2px;background:#13BE9F;box-shadow:0 0 16px rgba(19,190,159,.6);animation:sfNeon 4.5s ease-in-out infinite"
  >
  </div>
  <div style={`position:absolute;inset:0;background-image:${ruido};pointer-events:none`}></div>
  <div data-r-footpad style="position:relative;max-width:1240px;margin:0 auto;padding:78px 32px 0">
    <div
      data-r-foot
      style="display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:48px;padding-bottom:58px"
    >
      <div style="display:flex;flex-direction:column;gap:18px">
        <img
          src="/uploads/logo-branco.png"
          alt="Setfree"
          width="190"
          height="66"
          style="height:66px;width:max-content;margin:-16px 0 -12px -8px"
        />
        <p style="margin:0;font-size:14px;line-height:1.65;color:rgba(244,243,240,.6);max-width:300px">
          {txt.sobre[lang]}
        </p>
        <span
          style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45)"
          >DO ALÍVIO DA DOR À CURA COMPLETA</span
        >
      </div>

      <div style="display:flex;flex-direction:column;gap:12px">
        <span style={tituloEstilo}>{txt.contato[lang]}</span>
        <a href={WHATSAPP} data-h="verde" style={linkEstilo}>WhatsApp</a>
        <a href={`mailto:${EMAIL}`} data-h="verde" style={linkEstilo}>{EMAIL}</a>
        <a href={TELEFONE_HREF} data-h="verde" style={linkEstilo}>{TELEFONE}</a>
        <span style="color:rgba(244,243,240,.55);font-size:13.5px;line-height:1.5"
          >Rodovia Raposo Tavares, KM 22<br />The Square Open Mall · Cotia, SP</span
        >
      </div>

      <div style="display:flex;flex-direction:column;gap:12px">
        <span style={tituloEstilo}>{txt.navegacao[lang]}</span>
        {
          nav.map((n) => (
            <a href={route(n.key, lang)} data-h="verde" style={linkEstilo}>
              {n[lang]}
            </a>
          ))
        }
      </div>

      <div style="display:flex;flex-direction:column;gap:12px">
        <span style={tituloEstilo}>SOCIAL</span>
        <a href="https://www.linkedin.com/company/setfree" data-h="verde" style={linkEstilo}>LinkedIn</a>
        <a href="https://www.instagram.com/setfreebr" data-h="verde" style={linkEstilo}>Instagram</a>
        <a
          href="https://www.facebook.com/profile.php?id=100083381220607"
          data-h="verde"
          style={linkEstilo}>Facebook</a
        >
        <a href="https://intranet.setfree.com.br" data-h="verde" style={linkEstilo}
          >{txt.intranet[lang]}</a
        >
      </div>
    </div>

    <div
      data-r-footbar
      style="border-top:1px solid rgba(244,243,240,.12);padding:24px 0 28px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap"
    >
      <span style="font-size:13px;color:rgba(244,243,240,.5)">© 2026 Setfree · Cotia, SP</span>
      <span
        style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45)"
        >UMA EMPRESA E7 HEALTH HUB · IS 40:31</span
      >
      <span
        style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45)"
        >{txt.anvisa[lang]}</span
      >
    </div>
  </div>
</footer>

<a
  data-r-fab
  data-glass="1"
  data-h="fab"
  href={WHATSAPP}
  aria-label="WhatsApp"
  style="position:fixed;right:26px;bottom:26px;z-index:95;display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.5);backdrop-filter:blur(22px) saturate(170%);-webkit-backdrop-filter:blur(22px) saturate(170%);border:1px solid rgba(255,255,255,.7);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 16px 40px -14px rgba(13,13,13,.4);color:#0D0D0D;border-radius:999px;padding:13px 22px;font-family:Sora,'Helvetica Neue',sans-serif;font-size:14px;font-weight:600;overflow:hidden;animation:sfPulse 6s ease-in-out infinite"
>
  <span
    style="position:absolute;top:0;bottom:0;left:0;width:40%;background:linear-gradient(105deg,transparent,rgba(255,255,255,.35),transparent);animation:sfSheen 5s ease-in-out infinite;pointer-events:none"
  ></span>
  <svg viewBox="0 0 24 24" width="17" height="17" fill="#0B9C82" aria-hidden="true"
    ><path
      d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm5.4 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5s.8 1.9.8 2c.1.1.1.3 0 .5l-.4.6c-.2.2-.3.4-.1.7.1.3.7 1.2 1.6 1.9 1.1.9 2 1.2 2.3 1.4.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.7-.1l1.7.8c.3.1.5.2.5.3.1.1.1.6-.1 1.2Z"
    ></path></svg
  >
  <span data-r-fablabel>WhatsApp</span>
</a>

<style is:global>
  @media (max-width: 980px) {
    [data-r-foot] {
      grid-template-columns: 1fr 1fr !important;
      gap: 36px 40px !important;
    }
    [data-r-footpad] {
      padding: 62px 20px 0 !important;
    }
  }
  @media (max-width: 620px) {
    [data-r-foot] {
      grid-template-columns: 1fr !important;
      gap: 34px !important;
    }
    [data-r-footbar] {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 12px !important;
    }
    [data-r-fab] {
      right: 16px !important;
      bottom: 16px !important;
      padding: 14px !important;
    }
    [data-r-fablabel] {
      display: none !important;
    }
  }
  [data-h="fab"]:hover {
    background: rgba(255, 255, 255, 0.68);
    color: #0d0d0d;
  }
</style>
