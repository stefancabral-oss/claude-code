---
// Cartão de visita digital do time comercial.
//
// Uso: o vendedor envia setfree.com.br/cartao/<slug> pelo WhatsApp. O preview
// mostra a marca; ao tocar, o cliente abre este cartão e salva o contato com
// um toque (vCard em /cartao/<slug>.vcf), chama no WhatsApp, liga ou escreve.
//
// Página fora do sitemap e com noindex: é ferramenta comercial, não conteúdo
// de busca. Novos membros entram em src/data/time.json (um objeto por pessoa).
import "../../styles/global.css";
import time from "../../data/time.json";

export function getStaticPaths() {
  return time.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;

const SITE = Astro.site!.href.replace(/\/+$/, "");
const url = `${SITE}/cartao/${p.slug}`;
const cor = p.cor || "#13BE9F";
const waLink = `https://wa.me/${p.whatsapp}?text=${encodeURIComponent(`Olá, ${p.primeiroNome}! Recebi seu cartão da Setfree e quero conversar.`)}`;
const telHref = `tel:${p.telefone.replace(/[^\d+]/g, "")}`;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: p.nome,
  jobTitle: p.cargo,
  email: p.email,
  telephone: p.telefone,
  url,
  worksFor: { "@type": "MedicalOrganization", name: "Setfree", url: SITE },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{p.nome} · Setfree — cartão de visita</title>
    <meta name="description" content={`${p.nome}, ${p.cargo} na Setfree. Salve o contato, chame no WhatsApp ou escreva um e-mail.`} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={url} />

    <meta property="og:site_name" content="Setfree" />
    <meta property="og:title" content={`${p.nome} — ${p.cargo} · Setfree`} />
    <meta property="og:description" content={p.bio || "Importação e distribuição de tecnologia médica. Do alívio da dor à cura completa."} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE}/uploads/app-cartao-preto.jpg`} />
    <meta property="og:image:alt" content={`Cartão de visita Setfree — ${p.nome}`} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>

  <body style="background:#0D0D0D">
    <main style="max-width:430px;margin:0 auto;min-height:100svh;display:flex;flex-direction:column;background:#0D0D0D;color:#F4F3F0">
      <!-- capa: pena da marca + gradiente -->
      <header style="position:relative;overflow:hidden;padding:0">
        <img src={p.pena} alt="" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 40%;opacity:.8" />
        <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(13,13,13,.35) 0%,rgba(13,13,13,.1) 45%,#0D0D0D 100%)"></div>
        <div style="position:relative;padding:34px 28px 26px;display:flex;flex-direction:column;gap:86px">
          <img src="/uploads/logo-branco.png" alt="Setfree" style="height:26px;width:auto;align-self:flex-start" />
          <div>
            <span style={`font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.2em;color:${cor}`}>{p.cargo.toUpperCase()} · SETFREE</span>
            <h1 style="margin:10px 0 0;font-size:34px;line-height:1.08;letter-spacing:-.03em;font-weight:600;text-wrap:balance;text-shadow:0 2px 24px rgba(13,13,13,.5)">{p.nome}</h1>
          </div>
        </div>
        <div style={`position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,transparent,${cor} 15%,${cor} 85%,transparent);box-shadow:0 0 14px rgba(19,190,159,.5);animation:sfNeon 4.5s ease-in-out infinite`}></div>
      </header>

      <!-- ações -->
      <section style="padding:26px 22px 8px;display:flex;flex-direction:column;gap:12px">
        {p.bio && <p style="margin:0 0 8px;font-size:14.5px;line-height:1.6;color:rgba(244,243,240,.62)">{p.bio}</p>}

        <a href={`/cartao/${p.slug}.vcf`} download style={`display:flex;align-items:center;justify-content:center;gap:10px;background:${cor};color:#0D0D0D;border-radius:999px;padding:16px 24px;font-size:15.5px;font-weight:600`} data-h="btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
          Salvar contato na agenda
        </a>

        <a href={waLink} style="display:flex;align-items:center;gap:14px;background:rgba(244,243,240,.05);border:1px solid rgba(244,243,240,.14);border-radius:8px;padding:15px 18px;color:#F4F3F0" data-h="borda">
          <span style={`width:10px;height:10px;border-radius:50%;background:${cor};animation:sfPulse 2.4s ease-out infinite;flex:none`}></span>
          <span style="flex:1;display:flex;flex-direction:column;gap:2px">
            <strong style="font-size:15px;font-weight:600">WhatsApp</strong>
            <span style="font-size:12.5px;color:rgba(244,243,240,.5)">resposta rápida — canal preferido</span>
          </span>
          <span style={`color:${cor};font-weight:600`}>→</span>
        </a>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <a href={telHref} style="display:flex;flex-direction:column;gap:3px;background:rgba(244,243,240,.05);border:1px solid rgba(244,243,240,.14);border-radius:8px;padding:14px 16px;color:#F4F3F0" data-h="borda">
            <span style="font-family:'Space Grotesk',sans-serif;font-size:10px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45)">LIGAR</span>
            <strong style="font-size:13.5px;font-weight:600">{p.telefone}</strong>
          </a>
          <a href={`mailto:${p.email}`} style="display:flex;flex-direction:column;gap:3px;background:rgba(244,243,240,.05);border:1px solid rgba(244,243,240,.14);border-radius:8px;padding:14px 16px;color:#F4F3F0;min-width:0" data-h="borda">
            <span style="font-family:'Space Grotesk',sans-serif;font-size:10px;font-weight:600;letter-spacing:.16em;color:rgba(244,243,240,.45)">E-MAIL</span>
            <strong style="font-size:13.5px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{p.email}</strong>
          </a>
        </div>

        {p.linkedin && (
          <a href={p.linkedin} rel="noopener" style="display:flex;align-items:center;justify-content:space-between;background:rgba(244,243,240,.05);border:1px solid rgba(244,243,240,.14);border-radius:8px;padding:14px 18px;color:#F4F3F0;font-size:14.5px;font-weight:600" data-h="borda">
            LinkedIn <span style={`color:${cor}`}>→</span>
          </a>
        )}

        <button id="sf-share" style={`display:none;align-items:center;justify-content:center;gap:8px;background:transparent;border:1px dashed rgba(244,243,240,.25);border-radius:999px;padding:13px 22px;color:rgba(244,243,240,.75);font-family:inherit;font-size:14px;font-weight:500;cursor:pointer`}>
          Compartilhar este cartão
        </button>
      </section>

      <!-- empresa -->
      <footer style="margin-top:auto;padding:26px 28px 34px;border-top:1px solid rgba(244,243,240,.1)">
        <p style="margin:0 0 4px;font-family:'Space Grotesk',sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.18em;color:rgba(244,243,240,.45)">IMPORTAÇÃO E DISTRIBUIÇÃO · TECNOLOGIA MÉDICA</p>
        <p style="margin:0 0 14px;font-size:13.5px;line-height:1.55;color:rgba(244,243,240,.6)">“Transformamos dor em alívio, alívio em cura e cura em liberdade.”</p>
        <a href="/" style={`color:${cor};font-size:14px;font-weight:600`} data-h="verde-claro">setfree.com.br →</a>
      </footer>
    </main>

    <script>
      // "Compartilhar" só aparece onde o share nativo existe (o vendedor abre o
      // próprio cartão e manda pelo WhatsApp sem digitar nada).
      const btn = document.getElementById("sf-share");
      if (btn && navigator.share) {
        btn.style.display = "flex";
        btn.addEventListener("click", () => {
          navigator
            .share({ title: document.title, url: location.href })
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
