---
import SolucaoPage from "../../../layouts/SolucaoPage.astro";
import { solucao, solucoes } from "../../../data";
import { solucaoUrl } from "../../../lib/i18n";
import { comDominio, seo } from "../../../lib/seo";

export function getStaticPaths() {
  return solucoes("en").map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const d = solucao(slug!, "en");
const path = solucaoUrl(slug!, "en");
const meta = seo(solucaoUrl(slug!, "pt"), "en");

const site = Astro.site!.href.replace(/\/+$/, "");
const relacionada = (s: string) => {
  const x = solucao(s, "en");
  return { nome: x.nome, num: x.num };
};
---

<SolucaoPage
  lang="en"
  d={d}
  relacionada={relacionada}
  title={meta.title}
  description={meta.description}
  path={path}
  jsonLd={comDominio(meta.jsonLd, site)}
/>
