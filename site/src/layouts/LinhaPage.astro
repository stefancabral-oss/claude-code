---
import Base from "./Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { Linha } from "../data";
import { UI, WHATSAPP, linhaUrl, route, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  d: Linha;
  /** Nome das linhas relacionadas, já no idioma certo. */
  nomeDe: (slug: string) => string;
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
}

const { lang, d, nomeDe, title, description, path, jsonLd = [] } = Astro.props;

const cor = d.cor || "#474E58";
const corClara = d.corClara || "#8B929C";
const temLista = (x?: unknown[]) => Array.isArray(x) && x.length > 0;

const ruido =
  "url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%222%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22 opacity=%220.05%22/></svg>')";

const kicker =
  "font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em";
const secao = "background:#F4F3F0;border-top:1px solid rgba(13,13,13,.08)";

const breadcrumb = [
  { name: lang === "pt" ? "Início" : "Home", url: route("home", lang) },
  { name: UI.nav.tecnologias[lang], url: route("tecnologias", lang) },
  { name: d.nome, url: path },
];
---

<Base
  lang={lang}
  title={title}
  description={description}
  path={path}
  ogImage={d.pena}
  jsonLd={jsonLd}
  breadcrumb={breadcrumb}
>
  <div style="font-family:Sora,'Helvetica Neue',sans-serif;background:#F4F3F0;min-height:100vh">
    <SiteNav lang={lang} path={path} cor={corClara} />

    <header style="position:relative;background:#0D0D0D;color:#F4F3F0;overflow:hidden">
      <div style={`position:absolute;inset:0;background-image:${ruido};pointer-events:none`}></div>
      <div
        data-r="p1 g1"
        style="position:relative;max-width:1240px;margin:0 auto;padding:130px 32px 84px;display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center"
      >
        <div style="display:flex;flex-direction:column;gap:24px">
          <div
            data-reveal
            style="display:flex;align-items:center;gap:10px;font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.16em"
          >
            <a href={route("tecnologias", lang)} data-h="verde" style="color:rgba(244,243,240,.55)"
              >{UI.nav.tecnologias[lang]}</a
            >
            <span style="color:rgba(244,243,240,.35)">/</span>
            <span style={`color:${corClara}`}>{d.cat}</span>
          </div>
          <h1
            data-reveal
            style="margin:0;font-size:clamp(38px,4.6vw,64px);line-height:1.05;letter-spacing:-.03em;font-weight:600;text-wrap:balance"
          >
            {d.nome}
          </h1>
          <p
            data-reveal
            style="margin:0;max-width:540px;font-size:16.5px;line-height:1.65;color:rgba(244,243,240,.68)"
          >
            {d.tagline}
          </p>
          <div
            data-reveal
            style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:4px"
          >
            <a
              href={WHATSAPP}
              data-mag="1"
              data-h="btn"
              style="background:#13BE9F;color:#0D0D0D;border-radius:999px;padding:13px 26px;font-size:14.5px;font-weight:600;white-space:nowrap"
              >{UI.linha.falarEspecialista[lang]}</a
            >
            {
              d.catalogo && (
                <a
                  href={d.catalogo}
                  data-mag="1"
                  data-h="borda"
                  style="border:1px solid rgba(244,243,240,.25);color:#F4F3F0;border-radius:999px;padding:12px 24px;font-size:14.5px;font-weight:500;white-space:nowrap"
                >
                  {d.catalogoLabel}
                </a>
              )
            }
          </div>
        </div>
        <div data-reveal style="position:relative;display:flex;justify-content:center;align-items:center">
          <img
            src={d.pena}
            alt={`${UI.linha.penaAlt[lang]} ${d.nome}`}
            width="300"
            height="400"
            style="width:min(300px,26vw);height:auto;display:block;-webkit-mask-image:radial-gradient(72% 72% at 50% 48%,#000 50%,transparent 97%);mask-image:radial-gradient(72% 72% at 50% 48%,#000 50%,transparent 97%);animation:sfFloat 9s ease-in-out infinite"
          />
        </div>
      </div>
      <div style={`position:absolute;left:0;right:0;bottom:0;height:2px;background:${corClara};opacity:.9`}>
      </div>
    </header>

    {
      d.prod && (
        <section style="background:#E7E6E2;border-bottom:1px solid rgba(13,13,13,.06)">
          <div data-r="p2" style="max-width:1240px;margin:0 auto;padding:64px 32px;display:flex;justify-content:center">
            <img
              data-reveal
              src={d.prod}
              alt={d.nome}
              loading="lazy"
              style="max-width:min(640px,80%);max-height:380px;object-fit:contain;mix-blend-mode:multiply"
            />
          </div>
        </section>
      )
    }

    {
      d.overview && (
        <section style="background:#F4F3F0">
          <div
            data-r="p3 g2"
            style="max-width:1240px;margin:0 auto;padding:96px 32px;display:grid;grid-template-columns:1fr 1.2fr;gap:56px;align-items:start"
          >
            <div data-reveal>
              <span style={`${kicker};color:${cor}`}>{UI.linha.overview[lang]}</span>
              <h2 style="margin:18px 0 0;font-size:clamp(28px,3vw,40px);line-height:1.12;letter-spacing:-.03em;font-weight:600;text-wrap:balance">
                {d.overviewT}
              </h2>
            </div>
            <p data-reveal style="margin:6px 0 0;font-size:16.5px;line-height:1.75;color:#474E58">
              {d.overview}
            </p>
          </div>
        </section>
      )
    }

    {
      temLista(d.feats) && (
        <section style={secao}>
          <div data-r="p4" style="max-width:1240px;margin:0 auto;padding:88px 32px">
            <span data-reveal style={`${kicker};color:${cor}`}>
              {d.featsKicker}
            </span>
            <h2
              data-reveal
              style="margin:18px 0 44px;font-size:clamp(26px,2.8vw,36px);line-height:1.12;letter-spacing:-.03em;font-weight:600;max-width:640px;text-wrap:balance"
            >
              {d.featsT}
            </h2>
            <div data-r="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0">
              {d.feats!.map((f) => (
                <div data-reveal style="border-left:1px solid rgba(13,13,13,.12);padding:6px 28px 6px 22px">
                  <h3 style="margin:0 0 10px;font-size:17px;font-weight:600">{f.t}</h3>
                  <p style="margin:0;font-size:14px;line-height:1.65;color:#474E58">{f.d}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      temLista(d.modelos) && (
        <section style={secao}>
          <div data-r="p4" style="max-width:1240px;margin:0 auto;padding:88px 32px">
            <span data-reveal style={`${kicker};color:${cor}`}>
              {d.modelosKicker}
            </span>
            <h2
              data-reveal
              style="margin:18px 0 44px;font-size:clamp(26px,2.8vw,36px);line-height:1.12;letter-spacing:-.03em;font-weight:600;max-width:640px;text-wrap:balance"
            >
              {d.modelosT}
            </h2>
            <div data-r="g4" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px">
              {d.modelos!.map((m) => (
                <div
                  data-reveal
                  data-tilt="1"
                  style="background:#0D0D0D;border-radius:4px;overflow:hidden;display:flex;flex-direction:column"
                >
                  <span style="display:flex;align-items:center;justify-content:center;background:#E7E6E2;height:180px;padding:18px;position:relative">
                    <img
                      src={m.img}
                      alt={m.t}
                      loading="lazy"
                      style="max-width:100%;max-height:100%;object-fit:contain;mix-blend-mode:multiply"
                    />
                    {m.patch && (
                      <span style="position:absolute;left:44%;top:8%;width:16%;height:28%;background:#E7E6E2" />
                    )}
                  </span>
                  <span style="display:flex;flex-direction:column;gap:7px;padding:16px 20px 20px">
                    <span style="font-size:16.5px;font-weight:600;color:#F4F3F0">{m.t}</span>
                    <span style="font-size:13px;color:rgba(244,243,240,.55);line-height:1.55">{m.d}</span>
                  </span>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      temLista(d.especs) && (
        <section style={secao}>
          <div
            data-r="p4 g2"
            style="max-width:1240px;margin:0 auto;padding:88px 32px;display:grid;grid-template-columns:1fr 1.2fr;gap:56px;align-items:start"
          >
            <div data-reveal>
              <span style={`${kicker};color:${cor}`}>{UI.linha.especificacoes[lang]}</span>
              <h2 style="margin:18px 0 0;font-size:clamp(26px,2.8vw,36px);line-height:1.12;letter-spacing:-.03em;font-weight:600;text-wrap:balance">
                {d.especsT}
              </h2>
            </div>
            <div data-reveal style="display:flex;flex-direction:column">
              {d.especs!.map((e) => (
                <div
                  data-r="g5"
                  style="display:grid;grid-template-columns:200px 1fr;gap:20px;padding:15px 0;border-top:1px solid rgba(13,13,13,.1)"
                >
                  <span style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11.5px;font-weight:600;letter-spacing:.16em;color:#474E58;padding-top:2px">
                    {e.k}
                  </span>
                  <span style="font-size:15px;font-weight:600">{e.v}</span>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      temLista(d.uso) && (
        <section style="background:#E7E6E2;border-top:1px solid rgba(13,13,13,.06)">
          <div data-r="p4" style="max-width:1240px;margin:0 auto;padding:88px 32px">
            <span data-reveal style={`${kicker};color:${cor}`}>
              {UI.linha.modoUso[lang]}
            </span>
            <h2
              data-reveal
              style="margin:18px 0 40px;font-size:clamp(26px,2.8vw,36px);line-height:1.12;letter-spacing:-.03em;font-weight:600"
            >
              {UI.linha.modoUsoT[lang]}
            </h2>
            <div data-r="g3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:0">
              {d.uso!.map((u) => (
                <div data-reveal style="border-left:1px solid rgba(13,13,13,.12);padding:6px 28px 6px 22px">
                  <span style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:12px;font-weight:600;letter-spacing:.16em;color:#474E58">
                    {u.n}
                  </span>
                  <p style="margin:12px 0 0;font-size:14.5px;line-height:1.65;color:#474E58">{u.d}</p>
                </div>
              ))}
            </div>
            <p
              data-reveal
              style="margin:36px 0 0;font-family:Sora,'Helvetica Neue',sans-serif;font-size:14.5px;color:#474E58"
            >
              {UI.linha.modoUsoNota[lang]}
            </p>
          </div>
        </section>
      )
    }

    {
      temLista(d.aplicacoes) && (
        <section style={secao}>
          <div data-r="p4" style="max-width:1240px;margin:0 auto;padding:88px 32px">
            <span data-reveal style={`${kicker};color:${cor}`}>
              {UI.linha.aplicacoes[lang]}
            </span>
            <h2
              data-reveal
              style="margin:18px 0 40px;font-size:clamp(26px,2.8vw,36px);line-height:1.12;letter-spacing:-.03em;font-weight:600;text-wrap:balance"
            >
              {d.aplicT}
            </h2>
            <div data-r="g6" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0">
              {d.aplicacoes!.map((a) => (
                <div style="border-left:1px solid rgba(13,13,13,.12);padding:6px 24px 6px 22px;font-size:16px;font-weight:600;letter-spacing:-.01em" data-reveal>
                  {a}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section style={secao}>
      <div
        data-r="p4 g7"
        style="max-width:1240px;margin:0 auto;padding:88px 32px;display:grid;grid-template-columns:1fr 1fr;gap:22px"
      >
        <div
          data-reveal
          data-tilt="1"
          data-r="p5"
          style={`background:#0D0D0D;border-radius:4px;border-top:3px solid ${corClara};padding:32px;color:#F4F3F0;display:flex;flex-direction:column;gap:12px`}
        >
          <span
            style={`font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:${corClara}`}
            >{UI.linha.cotacao[lang]}</span
          >
          <h3 style="margin:0;font-size:22px;font-weight:600">{UI.linha.cotacaoT[lang]}</h3>
          <p style="margin:0;font-size:14px;line-height:1.6;color:rgba(244,243,240,.6);flex:1">
            {UI.linha.cotacaoD[lang]}
          </p>
          <a href={WHATSAPP} data-h="verde-claro" style="color:#13BE9F;font-size:14.5px;font-weight:600"
            >{UI.linha.falarWhatsSeta[lang]}</a
          >
        </div>

        {
          d.catalogo && (
            <div
              data-reveal
              data-tilt="1"
              data-r="p5"
              style="background:#E7E6E2;border:1px solid rgba(13,13,13,.08);border-radius:4px;padding:32px;display:flex;flex-direction:column;gap:12px"
            >
              <span style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:#474E58">
                {d.catalogoKicker ?? (lang === "pt" ? "PDF · CATÁLOGO DO PRODUTO" : "PDF · PRODUCT CATALOGUE")}
              </span>
              <h3 style="margin:0;font-size:22px;font-weight:600">{d.catalogoNome}</h3>
              <p style="margin:0;font-size:14px;line-height:1.6;color:#474E58;flex:1">
                {UI.linha.catalogoD[lang]}
              </p>
              <a href={d.catalogo} data-h="verde-escuro" style="color:#13BE9F;font-size:14.5px;font-weight:600">
                {UI.linha.baixar[lang]}
              </a>
            </div>
          )
        }

        {
          d.cnn && (
            <div
              data-reveal
              data-tilt="1"
              data-r="p5"
              style="background:#E7E6E2;border:1px solid rgba(13,13,13,.08);border-radius:4px;padding:32px;display:flex;flex-direction:column;gap:12px"
            >
              <span style="font-family:'Space Grotesk','Helvetica Neue',sans-serif;font-size:11px;font-weight:600;letter-spacing:.16em;color:#474E58">
                {UI.cnn.kicker[lang]}
              </span>
              <h3 style="margin:0;font-size:22px;font-weight:600">{UI.cnn.t[lang]}</h3>
              <p style="margin:0;font-size:14px;line-height:1.6;color:#474E58;flex:1">{UI.cnn.d[lang]}</p>
              <a
                href="https://edition.cnn.com/2014/09/28/business/inside-a-million-dollar-coral-farm"
                data-h="verde-escuro"
                style="color:#13BE9F;font-size:14.5px;font-weight:600"
              >
                {UI.cnn.link[lang]}
              </a>
            </div>
          )
        }
      </div>
    </section>

    <section style={secao}>
      <div data-r="p6" style="max-width:1240px;margin:0 auto;padding:72px 32px 96px">
        <div
          data-reveal
          style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:30px"
        >
          <h2 style="margin:0;font-size:clamp(24px,2.6vw,32px);letter-spacing:-.03em;font-weight:600">
            {UI.linha.outras[lang]}
          </h2>
          <a href={route("tecnologias", lang)} data-h="verde-escuro" style="color:#13BE9F;font-size:14.5px;font-weight:600"
            >{UI.linha.verTodas[lang]}</a
          >
        </div>
        <div data-r="g4" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px">
          {
            d.outras.map((o) => (
              <a
                href={linhaUrl(o.slug, lang)}
                data-reveal
                data-tilt="1"
                data-h="card"
                style="display:flex;align-items:center;gap:16px;background:#0D0D0D;border-radius:4px;padding:14px 20px 14px 14px;color:#F4F3F0"
              >
                <span style="display:flex;width:40px;height:54px;border-radius:3px;overflow:hidden;flex:none">
                  <img
                    src={o.pena}
                    alt=""
                    loading="lazy"
                    style="width:100%;height:100%;object-fit:cover;object-position:50% 35%"
                  />
                </span>
                <span style="flex:1;font-size:16px;font-weight:600">{nomeDe(o.slug)}</span>
                <span style={`color:${corClara};font-weight:600`}>→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <SiteFooter lang={lang} />
  </div>
</Base>

<style is:global>
  /* Bloco responsivo do LinhaPage — os nomes p1/g1 têm valores diferentes em
     outras páginas, por isso não podem ir para o global.css. */
  @media (max-width: 980px) {
    [data-r~="p1"] {
      padding: 104px 22px 57px !important;
    }
    [data-r~="p2"] {
      padding: 44px 22px !important;
    }
    [data-r~="p3"] {
      padding: 65px 22px !important;
    }
    [data-r~="p4"] {
      padding: 60px 22px !important;
    }
    [data-r~="p5"] {
      padding: 22px !important;
    }
    [data-r~="p6"] {
      padding: 49px 22px 65px !important;
    }
    [data-r~="g1"],
    [data-r~="g2"] {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
    [data-r~="g3"],
    [data-r~="g4"],
    [data-r~="g6"] {
      grid-template-columns: repeat(2, 1fr) !important;
    }
    [data-r~="g7"] {
      grid-template-columns: 1fr !important;
    }
  }
  @media (max-width: 620px) {
    [data-r~="g3"],
    [data-r~="g4"],
    [data-r~="g5"],
    [data-r~="g6"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>
