# Copie para .env e preencha. NUNCA suba o .env real para o Git.

# Sua chave da API do Claude (Anthropic). Uso e pago por chamada.
# Pegue em: https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Modelo (pelo que ele faz). Padrao: claude-opus-5.
# Alternativa mais barata: claude-sonnet-5
MODEL=claude-opus-5

# Porta do servidor (o Dokploy costuma cuidar disso)
PORT=8080
