# Build do site: pré-render com Playwright/Chromium → nginx serve o dist/ estático.

# --- estágio 1: pré-render ---------------------------------------------------
FROM mcr.microsoft.com/playwright:v1.56.1-jammy AS build
WORKDIR /app
# o Chromium já está na imagem (/ms-playwright); não baixar de novo no npm install
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# domínio do build: canonical, og:url, sitemap e JSON-LD saem com este endereço.
# Vazio = produção (https://setfree.com.br). Qualquer outro valor marca o build
# como não-produção e o robots.txt gerado bloqueia os robôs.
ARG SITE_URL=""
ENV SITE_URL=$SITE_URL
# o Chromium já vem na imagem do Playwright; o prerender usa o default se não achar o path local
RUN node build/prerender.mjs

# --- estágio 2: servidor estático -------------------------------------------
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
