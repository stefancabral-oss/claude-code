# Build do site: Astro gera HTML estático → nginx serve o dist/.
#
# Antes daqui rodava um pré-render com Playwright/Chromium sobre a imagem
# mcr.microsoft.com/playwright (~2 GB), porque o site montava tudo no cliente.
# O Astro já emite HTML, então o build volta a ser node + nginx.

# --- estágio 1: build ---------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

# domínio do build: canonical, og:url, sitemap e JSON-LD saem com este endereço.
# Vazio = produção (https://setfree.com.br). Qualquer outro valor marca o build
# como não-produção e o robots.txt gerado bloqueia os robôs.
ARG SITE_URL=""
ENV SITE_URL=$SITE_URL

COPY site/package.json site/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY site/ ./
# uploads/ vive na raiz do repositório; o script de build copia para o dist/
COPY uploads/ /uploads/
ENV UPLOADS_DIR=/uploads
RUN npm run build

# --- estágio 2: servidor estático ---------------------------------------------
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
